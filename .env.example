APP_NAME="SABA Máquinas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081
APP_PORT=8081

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=saba
DB_USERNAME=sail
DB_PASSWORD=password
FORWARD_DB_PORT=3307

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
FORWARD_REDIS_PORT=6380

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contato@sabamaquinas.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
VITE_PORT=5174

# Store settings will be persisted later through the Settings domain.
STORE_WHATSAPP=
STORE_POSTAL_CODE=

# Payment integrations - intentionally empty in starter.
MERCADO_PAGO_ACCESS_TOKEN=
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_SANDBOX=true

# Shipping integrations - intentionally empty in starter.
MELHOR_ENVIO_TOKEN=

PAYMENT_GATEWAY=fake
SHIPPING_PROVIDER=fake
ADDRESS_LOOKUP_PROVIDER=viacep
